# Purpose: keep build output, tool caches and private planning files out of the public repo

# Packaged extension and scratch output
*.rbz
/tmp/
/coverage/
/pkg/

# Bundler and RuboCop caches
Gemfile.lock
/.bundle/
/vendor/bundle/
.rubocop-https--*

# Documentation build output
/.yardoc/
/_yardoc/
/doc/
/rdoc/

# Private planning notes and agent scratch. Never committed; planning lives in the private
# plugins repository.
/local/
/.superpowers/
CLAUDE.local.md
.claude/settings.local.json
.mcp.local.json

# SketchUp backup files
*.skb
AutoSave_*.skp
Backup of *.layout

# OS noise
.DS_Store
Thumbs.db
