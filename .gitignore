*.rbz
/tmp/
/coverage/
/pkg/

# Bundler and RuboCop caches
Gemfile.lock
/.bundle/
/vendor/bundle/
.rubocop-https--*

# Documentation build output
/.yardoc/
/_yardoc/
/doc/
/rdoc/

# Private planning notes. Never committed.
/local/

# SketchUp backup files
*.skb
AutoSave_*.skp
Backup of *.layout

# OS noise
.DS_Store
Thumbs.db
